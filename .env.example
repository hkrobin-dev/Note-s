# My Life OS — Environment
#
# Two modes:
#  1. Local split dev: frontend/.env + backend/.env (see those files).
#  2. Vercel single project: set the variables below in Project Settings.
#
# Never commit real values.

# --- Database (Neon PostgreSQL) ---
# Use the pooled connection string for the app and migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require&schema=public"

# --- Auth / security (required for a public deployment) ---
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AUTH_ENFORCE=true
CRON_SECRET=change-me-in-production

# --- App URLs ---
FRONTEND_URL=https://<your-app>.vercel.app
# NEXT_PUBLIC_API_URL is for local split dev only; leave unset on Vercel
# because the API is mounted at the same origin.
NEXT_PUBLIC_API_URL=http://localhost:4100

# --- Files ---
# Uploaded bytes live in Neon (StoredFile.data). Keep the limit below Vercel's
# 4.5 MB request body limit.
MAX_FILE_SIZE_MB=4

# --- Local only ---
PORT=4100
UPLOAD_DIR=./uploads
APP_TIMEZONE=Asia/Dhaka
APP_CURRENCY=BDT

# --- Ask your life (AI provider) — backend variables, never NEXT_PUBLIC_* ---
AI_PROVIDER=ollama
AI_RERANK_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:3b

# NVIDIA NIM (backend only; secret key must not be prefixed NEXT_PUBLIC_)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
NVIDIA_RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
