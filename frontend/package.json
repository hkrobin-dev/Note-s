{
  "name": "my-life-os-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "My Life OS — Next.js frontend and Express API in one Vercel project",
  "scripts": {
    "predev": "npm run db:generate && npm run copy:backend",
    "dev": "next dev -p 3100",
    "prebuild": "npm run db:generate && npm run copy:backend",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "db:generate": "prisma generate --config prisma.config.ts",
    "copy:backend": "node scripts/copy-backend.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.105.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.62.0",
    "multer": "^1.4.5-lts.1",
    "next": "16.4.6",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
