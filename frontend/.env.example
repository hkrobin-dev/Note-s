# Local development only.
# On Vercel, API calls are same-origin (/api/*) and these are not needed.
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_APP_URL=http://localhost:3100

# App
NEXT_PUBLIC_APP_TIMEZONE=Asia/Dhaka
NEXT_PUBLIC_APP_CURRENCY=BDT

# ---------------------------------------------------------------------------
# Vercel (single project) — set these in Project Settings > Environment Variables
# ---------------------------------------------------------------------------
# DATABASE_URL      = Neon pooled Postgres URL (also used by Prisma migrations)
# JWT_SECRET        = long random secret (required when AUTH_ENFORCE=true)
# AUTH_ENFORCE      = true  (public deployment must require login)
# CRON_SECRET       = long random secret used by /api/cron/tick
# FRONTEND_URL      = https://<your-app>.vercel.app
# MAX_FILE_SIZE_MB  = 4  (Vercel request body limit; files are stored in Neon)
# AI_PROVIDER       = ollama | nvidia
# NVIDIA_API_KEY    = (only when AI_PROVIDER=nvidia; never NEXT_PUBLIC_*)
