{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/auth/:path*", "destination": "/api/auth/:path*" }
  ],
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "src/pages/api/[...path].ts": {
      "maxDuration": 60
    }
  }
}
