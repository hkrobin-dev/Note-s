# PostgreSQL connection — use the Neon pooled URL in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Backend (local standalone mode; ignored on Vercel where the API is mounted
# inside the Next.js app)
PORT=4100
NODE_ENV=production
API_BASE_URL=http://localhost:4100
FRONTEND_URL=http://localhost:3100

# JWT — generate a strong random value for production
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Require login for /api/* (true) or keep demo mode (false).
# Set to true on any public deployment.
AUTH_ENFORCE=false

# Vercel Cron secret. The cron endpoint requires Authorization: Bearer $CRON_SECRET.
CRON_SECRET=change-me-in-production

# File storage. On Vercel, file bytes are stored in the Neon "StoredFile.data"
# BYTEA column because the serverless filesystem is read-only/ephemeral.
# UPLOAD_DIR is only used for legacy local files.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=4

# Timezone / currency
APP_TIMEZONE=Asia/Dhaka
APP_CURRENCY=BDT

# --- Ask your life (AI provider) ---
# See docs/AI_SETUP.md. Provider is selected on the BACKEND only; never expose keys to the frontend.
# ollama = fully local (default). nvidia = hosted NVIDIA NIM (no local Ollama needed in production).
AI_PROVIDER=ollama
# nemotron reranking (NVIDIA only): enabled by default; set false to opt out
AI_RERANK_ENABLED=true
# Tunables (optional)
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_REINDEX_BATCH=25

# Local AI (Ollama) — Inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:3b
# OLLAMA_EMBED_DIM=768

# NVIDIA NIM / Nemotron — backend-only. Keep NVIDIA_API_KEY secret.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
NVIDIA_RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
# NVIDIA_RERANK_BASE_URL=https://ai.api.nvidia.com/v1
# NVIDIA_EMBED_DIM=2048

# Email (Gmail) — for notifications
EMAIL_USER=hkrobin49@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="My Life OS <hkrobin49@gmail.com>"
NEXT_PUBLIC_APP_URL=http://localhost:3001
